---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pageDesc =
	'中学受験国語の読解・記述・選択肢問題の解法から、教材選び・志望校別の出題傾向まで。国語先生.COMブログの全記事一覧です。';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`ブログ記事一覧｜${SITE_TITLE}`} description={pageDesc} />
	</head>
	<body>
		<Header />
		<section class="hero" id="content">
			<div class="hero-copy">
				<p class="eyebrow">記事一覧</p>
				<h1>ブログ記事一覧</h1>
				<p class="hero-lead">中学受験国語の解法・勉強法・志望校の出題傾向をまとめています。</p>
			</div>
		</section>
		<main>
			<section class="section">
				<p class="section-kicker">最初に読む3つのガイド</p>
				<h2>つまずきを診断して、必要な型から直す。</h2>
				<p class="large-text">
					点数だけでは原因が見えません。まず弱点を4分類し、その後に選択肢または記述の手順を練習できる順番にしました。
				</p>
				<div class="guide-grid">
					<a class="guide-card" href="/blog/kokugo-jakuten-shindan/">
						<p class="guide-label">01 診断</p>
						<h2>国語の弱点を4つに分ける</h2>
						<p>12項目のチェック表で、「読む・探す・答える・運用する」のどこで止まっているかを見つけます。</p>
					</a>
					<a class="guide-card" href="/blog/sentakushi-saigo-2taku/">
						<p class="guide-label">02 選択肢</p>
						<h2>最後の2択を根拠で決める</h2>
						<p>本文根拠・言い過ぎ・因果のずれを、判定する順番と記録表まで含めて解説します。</p>
					</a>
					<a class="guide-card" href="/blog/kijutsu-mondai-5steps/">
						<p class="guide-label">03 記述</p>
						<h2>記述答案を5段階で組み立てる</h2>
						<p>設問のゴール、採点要素、本文根拠を先に決め、白紙や的外れを防ぐ答案設計です。</p>
					</a>
				</div>
				<nav class="topic-links" aria-label="悩み別の記事">
					<a href="/blog/kokugo-hensachi-agaranai/">偏差値が上がらない</a>
					<a href="/blog/yomu-osoi-jikangire/">読むのが遅い</a>
					<a href="/blog/goui-tarinai-dokkai/">語彙が足りない</a>
					<a href="/blog/kokugo-fukushu-naoshi-note/">復習のやり方</a>
					<a href="/blog/shinjo-mondai-yomitori/">心情問題</a>
				</nav>
			</section>
			<section class="section">
				<p class="section-kicker">全記事</p>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a class="post-card" href={`/blog/${post.id}/`}>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2>{post.data.title}</h2>
									<p class="excerpt">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
