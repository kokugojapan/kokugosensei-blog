---
// 記事の末尾に出す国語道場の案内（2026-11-23）。リンクは utm_source=blog で計測する。
const utm = 'utm_source=blog&utm_medium=article&utm_campaign=post_footer';
const lpUrl = `https://dojo.kokugosensei.com/lp/?${utm}`;
---

<aside class="dojo-cta" aria-label="国語道場のご案内">
	<p class="dojo-cta-kicker">国語道場</p>
	<p class="dojo-cta-lead">国語の知識は、毎日1問ずつ積むのがいちばん確実です。</p>
	<p class="dojo-cta-body">
		国語道場は、中学・高校受験の国語を毎日1問のクイズと、まちがえた問題のやり直しで鍛えるオンラインの道場です。
	</p>
	<p class="dojo-cta-links">
		<a class="dojo-cta-btn" href={lpUrl}>体験入門（5日間無料）</a>
	</p>
</aside>

<style>
	.dojo-cta {
		margin: 2.5rem 0 1.5rem;
		padding: 1.25rem 1.25rem 1.1rem;
		border: 1px solid var(--line);
		border-left: 4px solid var(--accent);
		border-radius: 6px;
		background: color-mix(in srgb, var(--accent) 6%, transparent);
	}
	.dojo-cta p { margin: 0 0 0.6rem; }
	.dojo-cta-kicker { color: var(--accent); font-size: 0.85rem; letter-spacing: 0.08em; }
	.dojo-cta-lead { font-size: 1.05rem; color: var(--ink); }
	.dojo-cta-body { font-size: 0.95rem; line-height: 1.8; }
	.dojo-cta-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; margin-bottom: 0; }
	.dojo-cta-btn {
		display: inline-block;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--paper);
		text-decoration: none;
	}
	.dojo-cta-sub { font-size: 0.92rem; color: var(--accent); }
</style>
